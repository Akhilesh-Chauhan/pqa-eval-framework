{
  "name": "pqa-qa",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "qa": "playwright test",
    "qa:unit": "playwright test --project=unit",
    "qa:isolation": "playwright test --project=isolation",
    "typecheck": "tsc --noEmit",
    "qa:admin:login": "node --env-file=.env scripts/admin-login.mjs",
    "qa:admin": "playwright test --project=admin-public --project=admin",
    "qa:share": "node scripts/share-report.mjs",
    "qa:design:login": "node --env-file=.env scripts/design-login.mjs",
    "qa:design": "playwright test --project=design-portal",
    "qa:design:labels": "playwright test --project=unit src/support/design-labels.spec.ts",
    "qa:pipeline": "npm run typecheck && npm run qa:unit && npm run qa:design",
    "qa:di:record": "node --env-file=.env scripts/di-record.mjs",
    "qa:ingest:provision": "PQA_INGEST=1 playwright test --project=ingestion-provision && node --env-file=.env scripts/portal-login.mjs",
    "qa:ingest": "PQA_INGEST=1 playwright test --project=ingestion",
    "qa:ingest:retire": "PQA_INGEST=1 playwright test --project=ingestion-retire"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@opensearch-project/opensearch": "^2.13.0",
    "pg": "^8.13.0"
  }
}
