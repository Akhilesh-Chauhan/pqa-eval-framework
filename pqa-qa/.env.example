# Target. No default exists; the suite refuses to run without this.
PQA_BASE_URL=

# Comma-separated tenant slugs to probe. The suite reports which resolve.
PQA_TENANT_CANDIDATES=

# Identities. Only the platform admin is required; each additional persona
# unlocks the attack families that need a lower-privileged attacker.
PLATFORM_SEED_EMAIL=
PQA_PERSONA_PARLIAMENT_ADMIN_EMAIL=
PQA_PERSONA_PARLIAMENT_MEMBER_EMAIL=
PQA_PERSONA_DIVISION_ADMIN_EMAIL=
PQA_PERSONA_DIVISION_MEMBER_EMAIL=

# Optional. Absent → families 4, 5 and the database half of 8 report
# "not measured" rather than passing. Ask Bhupendra (S1-DO-02).
PQA_S3_REGION=
PQA_S3_BUCKET=
PQA_S3_ACCESS_KEY_ID=
PQA_S3_SECRET_ACCESS_KEY=
PQA_S3_TENANT_PREFIX=
PQA_OPENSEARCH_ENDPOINT=
PQA_OPENSEARCH_USERNAME=
PQA_OPENSEARCH_PASSWORD=
PQA_OPENSEARCH_TENANT_INDEX=
PQA_POSTGRES_DSN=

# Optional. Generated per run when unset.
PQA_RUN_ID=

# ── Super Admin panel suite (npm run qa:admin) ──────────────────────────────
# PQA_BASE_URL above is also the ministry portal these tests open after an
# admin action. Sign-in: run `npm run qa:admin:login`, type the OTP in the
# browser that opens; the session is saved to src/.auth/ (8 h, ~1 h idle).
PQA_ADMIN_URL=https://pqa-admin.myscheme.in
PQA_ADMIN_EMAIL=

# Existing tenant the read-only and edit tests use.
PQA_ADMIN_TEST_TENANT=educat

# Off by default. true lets tests create, edit and archive tenants on the
# shared environment: every create claims a real ministry until archived,
# and an archived slug can never be reused.
PQA_ADMIN_ALLOW_WRITES=false

# The lifecycle test creates one tenant per ministry here (used only when writes
# are on). Separate with `;` — some ministry names contain commas.
PQA_ADMIN_TEST_MINISTRIES=
PQA_ADMIN_TENANT_ADMIN_NAME=
PQA_ADMIN_TENANT_ADMIN_EMAIL=
PQA_ADMIN_LLM_API_KEY=
PQA_ADMIN_LLM_BASE_URL=
PQA_ADMIN_LLM_MODEL=
PQA_ADMIN_LLM_EMBEDDING_MODEL=

# An inbox you control, for People-tab tests (adding a person sends an invitation).
PQA_ADMIN_PEOPLE_EMAIL=

# Optional. The internal test-case catalogue (kept outside this public repo); the HTML
# report shows each test's catalogue row and the catalogue coverage when it is set.
PQA_CATALOGUE=

# ── AI Assistant ingestion golden dataset (npm run qa:ingest) ───────────────
# The dataset folder, kept outside this repo (binary test files): …/PQA Builder/qa/golden/ingestion
PQA_GOLDEN_DIR=
# Written by `npm run qa:ingest:provision`: the disposable tenant (qi + 4 hex). Never a real tenant.
PQA_INGEST_TENANT=
# Optional: run only these categories' golden datasets, comma-separated (e.g. Advisory,Parliamentary Q&A).
# Pair with `npm run qa:ingest -- --grep category` to skip the format gate. Blank runs all 16.
PQA_INGEST_CATEGORY=
# Optional. Who signs in to that tenant's portal; defaults to PQA_ADMIN_TENANT_ADMIN_EMAIL.
PQA_INGEST_ADMIN_EMAIL=

# ── AI Assistant evaluation ─────────────────────────────────────────────────
# Tenant whose assistant is evaluated. Any slug; comind is allowed here (read-only use).
PQA_ASSISTANT_TENANT=
# The golden dataset folder for the assistant questions (kept outside this repo).
PQA_ASSISTANT_GOLDEN_DIR=
# Optional. Names the run folder under runs/assistant/; default <dataset>-<tenant>-<date>.
PQA_ASSISTANT_RUN=
# Optional. Who signs in to the assistant; defaults to PQA_ADMIN_TENANT_ADMIN_EMAIL.
PQA_ASSISTANT_ADMIN_EMAIL=
# Which assistant endpoint to exercise: chat (default) or generate.
PQA_ASSISTANT_STREAM=chat
# Set to 1 to parse the golden files again instead of reusing the last run's.
PQA_ASSISTANT_REPARSE=0
# Blank = sqlite:///mlruns/mlflow.db
MLFLOW_TRACKING_URI=

# ── UI/UX design conformance (npm run qa:design) ────────────────────────────
# Cases come only from the shared UI/UX design: PQA Builder/qa/design-test-cases.md (DS-*).
# Tenant the portal design cases open. Unset → every portal design case reports "not measured".
PQA_DESIGN_TENANT=
# Who signs in as each design persona (npm run qa:design:login -- executive|parliament|division).
PQA_DESIGN_EXECUTIVE_EMAIL=
PQA_DESIGN_PARLIAMENT_EMAIL=
PQA_DESIGN_DIVISION_EMAIL=
# Off by default. true lets Auto-W design cases save, send and submit. QA-owned disposable tenant only.
PQA_DESIGN_ALLOW_WRITES=
# The design snapshot's label inventory (kept outside this repo):
# …/PQA Builder/qa/design/pqa-ui-design-2026-11-20/design_inventory.json
PQA_DESIGN_INVENTORY=
# A QA-made question-only PDF for upload steps (never a Monsoon 2026 answer document: holdout).
PQA_DESIGN_QUESTION_PDF=
# Tester-owned inbox for Input Collaboration Requests.
PQA_DESIGN_COLLAB_EMAIL=
# AI Assistant answer quality (DS-EXAI quality cases): the golden sets folder …/PQA Builder/qa/golden,
# and how many rows each quality case asks per run (default 10; 0 = every row).
PQA_DESIGN_GOLDEN_ROOT=
PQA_DESIGN_QUALITY_LIMIT=

# ── Document Intelligence evaluation (npm run qa:di:record) ─────────────────
# Disposable tenant the DI questions are uploaded to (sign in with PQA_DESIGN_TENANT set to the same slug).
PQA_DI_TENANT=
# Folder of question-only PDFs + manifest.json from …/qa/golden/document-intelligence/di-eval/make_question_pdfs.py
PQA_DI_PDF_DIR=
# Uploads and drafts change the tenant: true only on a QA-owned disposable tenant.
PQA_DI_ALLOW_WRITES=
