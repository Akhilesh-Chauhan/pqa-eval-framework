  "cards": [
    {
      "dot": "cyan",
      "title": "Run order, one command each",
      "items": [
        "Super Admin: npm run qa:admin:login → qa:admin → qa:share",
        "Ingestion: qa:ingest:provision → qa:ingest → qa:ingest:retire (disposable tenant)",
        "Design: qa:design:login -- executive|parliament|division → qa:design; qa:pipeline = typecheck + unit + design",
        "Document Intelligence: qa:di:record -- parliament|division → extract_outputs.py → score_di.py",
        "AI Assistant: capture_new_chatbot.py / capture_search.py → cli.py → build_combined_report.py"
      ]
    },
    {
      "dot": "emerald",
      "title": "Results so far",
      "items": [
        "Super Admin: 398 pass, 20 fail, 16 skip (final run, 22–26 Oct)",
        "Ingestion golden run: type accuracy 0.907, metadata 0.665 across 13 types",
        "Generate reply, 115 questions: overall 0.75 with the reply ingested, 0.71 without; faithfulness 0.99 / 0.98",
        "Search, 40 queries: 18 of 25 ingested queries passed; the withheld reply was never returned (0 of 8)"
      ]
    },
    {
      "dot": "violet",
      "title": "Changed since v0.1 (29 Oct)",
      "items": [
        "The vendored Ragas scorer and MLflow plan are replaced by PQA_Chabot_Evaluation: RAGAS + MeitY judges on Claude Sonnet 5",
        "AI Assistant Search mode is evaluated next to Generate reply, in one combined report",
        "New: design conformance suite (DS-* cases) and the Document Intelligence recorder",
        "score_di.py can export DI drafts as PQA_Chabot_Evaluation rows, so the same judges score drafting"
      ]
    },
    {
      "dot": "amber",
      "title": "Shared inputs",
      "items": [
        "Golden sets and test catalogues live in PQA Builder/qa/, outside this repo",
        "Design AI-quality cases read the assistant golden sets (PQA_DESIGN_GOLDEN_ROOT)",
        "The DI recorder reuses the design-suite sessions; sign-in responses are never recorded",
        "Rajya Sabha session 271 is held out of the knowledge base to test answers without the document"
      ]
    },
    {
      "dot": "rose",
      "title": "Rules",
      "items": [
        "One Playwright process at a time; one process per saved session",
        "Writes only on a QA-owned disposable tenant (PQA_*_ALLOW_WRITES=true)",
        "Monsoon 2026 answer documents are never uploaded: they are the holdout",
        "Design cases come only from the shared design's FINAL page",
        "Judge cost is reported, never gated"
      ]
    }
  ]
