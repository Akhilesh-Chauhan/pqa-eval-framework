{
  "name": "pqa-qa",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "qa": "playwright test",
    "qa:unit": "playwright test --project=unit",
    "qa:isolation": "playwright test --project=isolation",
    "typecheck": "tsc --noEmit",
    "qa:admin:login": "node --env-file=.env scripts/admin-login.mjs",
    "qa:admin": "playwright test --project=admin-public --project=admin",
    "qa:share": "node scripts/share-report.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@opensearch-project/opensearch": "^2.13.0",
    "pg": "^8.13.0"
  }
}
